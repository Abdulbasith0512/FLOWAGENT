# ───────────────────────────────────────────────────────────────────────────
# FlowAgent environment - copy to `.env` and fill in.
# Only DATABASE_URL and ANTHROPIC_API_KEY are required for a basic local run;
# everything else has a documented fallback (mock search/email, in-memory
# checkpoints) so the app still boots and demos without those keys.
# ───────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Supabase Postgres connection string. Drizzle (web) and asyncpg (backend) both
# use this. Use the pooler URL for the web app; see web/src/db/index.ts notes.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowagent

# ── LLM (one provider required for real LLM nodes + describe-to-canvas) ──────
# Anthropic by default. To use a free provider instead, set GROQ_API_KEY and it
# takes over automatically (free key at console.groq.com). LiteLLM speaks both.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=                  # set this to use free Groq Llama models instead
# Advanced: override the model/key directly for any LiteLLM provider
# LLM_MODEL=anthropic/claude-sonnet-4-6
# LLM_FALLBACK_MODEL=anthropic/claude-haiku-4-5
# LLM_API_KEY=

# ── Optional integrations (mocked when absent) ───────────────────────────────
TAVILY_API_KEY=               # web-search node; empty -> mock results
RESEND_API_KEY=               # email + HITL approval; empty -> logged mock
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Checkpointing (optional; empty -> in-memory MemorySaver) ─────────────────
# Upstash Redis or any redis:// URL. Required in prod for durable HITL resume.
REDIS_URL=

# ── Code sandbox (optional) ──────────────────────────────────────────────────
# Docker image the code node runs in (no network, read-only, dropped caps).
# Requires Docker; falls back to a restricted subprocess when Docker is absent.
SANDBOX_IMAGE=python:3.12-alpine

# ── Run queue (ARQ + Redis) ──────────────────────────────────────────────────
# Durable background execution; events stream cross-process via Redis pub/sub.
# Set USE_QUEUE=false to run in-process (no worker/Redis needed).
QUEUE_REDIS_URL=redis://localhost:6379
USE_QUEUE=true

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs HITL approve/deny links. Generate: openssl rand -hex 32
HMAC_SECRET=change-me-dev-only
# Better Auth session secret. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-dev-only
# Encrypts stored credentials (AES-256-GCM). Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me-dev-only-encryption

# ── Service URLs ─────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000          # frontend base
API_BASE_URL=http://localhost:8000          # backend base; used in approval-email links
API_INTERNAL_URL=http://localhost:8000      # mcp -> backend (server-to-server)

# Exposed to the browser (Next.js):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── OAuth credential connections (optional) ──────────────────────────────────
# For connecting external services (Google/GitHub/Slack) as workflow credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
